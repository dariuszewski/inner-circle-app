{% extends "base_email.jinja" %}

{% macro subject() %}Reset your Inner Circle password{% endmacro %}

{% macro text_body() %}
{% autoescape false %}
Hello {{ username }},

Reset your Inner Circle password:
{{ reset_link }}

This link expires in {{ expiry_hours }} hours. If you didn't request a reset, you can ignore this email.
{% endautoescape %}
{% endmacro %}

{% block email_title %}Reset your password | Inner Circle{% endblock %}

{% block content %}
	<h1 style="margin: 0 0 20px; font-size: 24px;">Reset your password, {{ username }}</h1>
	<p style="margin: 0 0 24px;">Use the button below to choose a new password for your Inner Circle account.</p>
	<p style="margin: 0 0 24px;">
		<a href="{{ reset_link }}" style="display: inline-block; padding: 12px 18px; border-radius: 4px; background: #287354; color: #ffffff; font-weight: bold; text-decoration: none;">Reset password</a>
	</p>
	<p style="margin: 0 0 16px; color: #58645e; font-size: 13px;">This link expires in {{ expiry_hours }} hours. If you didn't request a reset, you can ignore this email.</p>
{% endblock %}