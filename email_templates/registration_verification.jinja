{% extends "base_email.jinja" %}

{% macro subject() %}Verify your Inner Circle email{% endmacro %}

{% macro text_body() %}
{% autoescape false %}
Hello {{ username }},

Thanks for joining Inner Circle. Verify your email address to activate your account:
{{ verification_link }}

This link expires in {{ expiry_hours }} hours. If you didn't create this account, you can ignore this email.
{% endautoescape %}
{% endmacro %}

{% block email_title %}Verify your email | Inner Circle{% endblock %}

{% block content %}
	<h1 style="margin: 0 0 20px; font-size: 24px;">Welcome, {{ username }}!</h1>
	<p style="margin: 0 0 20px;">Thanks for joining Inner Circle. Verify your email address to activate your account.</p>
	<p style="margin: 0 0 24px;">
		<a href="{{ verification_link }}" style="display: inline-block; padding: 12px 18px; border-radius: 4px; background: #287354; color: #ffffff; font-weight: bold; text-decoration: none;">Verify email address</a>
	</p>
	<p style="margin: 0 0 16px; color: #58645e; font-size: 13px;">This link expires in {{ expiry_hours }} hours. If you didn't create this account, you can ignore this email.</p>
{% endblock %}