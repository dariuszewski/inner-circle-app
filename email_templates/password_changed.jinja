{% extends "base_email.jinja" %}

{% macro subject() %}Your Inner Circle password was changed{% endmacro %}

{% macro text_body() %}
{% autoescape false %}
Hello {{ username }},

Your Inner Circle password was changed. If you didn't make this change, secure your account immediately.
{% endautoescape %}
{% endmacro %}

{% block email_title %}Password changed | Inner Circle{% endblock %}

{% block content %}
	<h1 style="margin: 0 0 20px; font-size: 24px;">Your password was changed</h1>
	<p style="margin: 0 0 16px;">Hello {{ username }}, your Inner Circle password was changed successfully.</p>
	<p style="margin: 0;">If you didn't make this change, secure your account immediately.</p>
{% endblock %}